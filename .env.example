# Copiar a .env y completar. El .env nunca se versiona.

DEBUG=false
CORS_ORIGINS=http://localhost:5173

# Desarrollo local: sqlite+aiosqlite:///./certa.db
# Despliegue: postgresql+asyncpg://usuario:clave@host/base
DATABASE_URL=sqlite+aiosqlite:///./certa.db

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiar-en-despliegue
JWT_EXPIRATION_MINUTES=480

# Proveedor de modelo. La credencial vive aqui, nunca en el repositorio.
# El servicio arranca sin ella; fallara al lanzar una validacion, con mensaje.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MODEL_VERSION=
LLM_TEMPERATURE=0.0
LLM_QUERIES_PER_MINUTE=60

# Presupuesto por ejecucion, en consultas.
BUDGET_MAX_QUERIES=3000
USD_PER_1K_INPUT=0.003
USD_PER_1K_OUTPUT=0.015

REPOSITORY_ROOT=./repos
CALLER_DEPTH=2
MAX_CONTEXT_LINES=250
RETENTION_DAYS=30
